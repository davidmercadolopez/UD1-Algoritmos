Algoritmo hipotenusa
	Escribir 'Calcular hipotenusa'
	Escribir 'Dame el cateto 1:'
	Definir cat1 Como Entero
	Leer cat1
	Escribir 'Dame el cateto 2:'
	Definir cat2 Como Entero
	Leer cat2
	Definir hip Como Real
	hip <- raiz((cat1^2)+(cat2^2))
	Escribir 'Dados los catetos, la hipotesusa es: ', hip
FinAlgoritmo
