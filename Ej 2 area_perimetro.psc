Algoritmo area_perimetro
	Escribir 'Calcular area y perimetro'
	Escribir 'Dame la base'
	Definir base Como Entero
	Leer base
	Escribir 'Dame la altura'
	Definir altura Como Entero
	Leer altura
	Definir area Como Entero
	Definir perimetro Como Entero
	area <- base*altura
	perimetro <- (base*2)+(altura*2)
	Escribir 'El area es ', area, ' y el perimetro es ', perimetro
FinAlgoritmo
