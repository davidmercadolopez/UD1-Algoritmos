Algoritmo Distancia
	
	Definir n1, n2, dist Como Entero
	
	Escribir "Distancia absoluta entre 2 números"
	Escribir "Dame el Primer número: "
	Leer n1
	Escribir "Dame el Segundo número: "
	Leer n2
	
	dist <- abs(n1-n2)
	
	Escribir "Distancia absoluta entre ", n1 " y ", n2 " es ",dist

FinAlgoritmo
