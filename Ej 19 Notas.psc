Algoritmo Notas
	Definir bien, mal, blanco, n_final Como entero
	
	Escribir "Nota Final"
	Escribir "Respuestas Correctas: "
	leer bien
	Escribir "Respuestas Incorrectas: "
	leer mal
	Escribir "Respuestas en Blanco: "
	leer blanco
	
	n_final <- bien*5 - mal 
	
	Escribir "Nota Final: " ,n_final
FinAlgoritmo
