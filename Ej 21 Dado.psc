Algoritmo Dado
	Definir cara Como Entero
	Escribir 'Cara del dado obtenida: '
	Leer cara
	Si cara<1 O cara>6 Entonces
		Escribir 'ERROR: número incorrecto'
	FinSi
	Si cara=1 Entonces
		Escribir 'Opuesta: 6'
	FinSi
	Si cara=2 Entonces
		Escribir 'Opuesta: 5'
	FinSi
	Si cara=3 Entonces
		Escribir 'Opuesta: 4'
	FinSi
	Si cara=4 Entonces
		Escribir 'Opuesta: 3'
	FinSi
	Si cara=5 Entonces
		Escribir 'Opuesta: 2'
	FinSi
	Si cara=6 Entonces
		Escribir 'Opuesta: 1'
	FinSi
FinAlgoritmo
