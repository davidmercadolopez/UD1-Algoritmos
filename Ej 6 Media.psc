Algoritmo Media
	Escribir "Media aritmética de 3 números"
	Escribir "Primer Número: "
	Definir n1 Como Real
	leer n1
	Escribir "Segundo Número: "
	Definir n2 Como Real
	leer n2
	Escribir "Tercer Número: "
	Definir n3 Como Real
	leer n3
	
	Definir opc Como Real
	opc <- (n1+n2+n3)/3
	
	Escribir "La media es: ", opc
	
FinAlgoritmo
